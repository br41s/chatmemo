# -------------------------------------------------------
# ChatMemo — Environment Variables
# Copy this file to .env.local and fill in the values.
# -------------------------------------------------------

# ── Supabase (REQUIRED) ─────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project ref = subdomain of NEXT_PUBLIC_SUPABASE_URL (the part before .supabase.co)
# Required for CLI operations: npx supabase link --project-ref <your-project-ref>
# After linking, use: npm run db-push  (apply migrations)
#                     npm run db-types-remote  (regenerate types from hosted DB)
SUPABASE_PROJECT_REF=your-project-ref

# ── OpenRouter (REQUIRED for MVP) ───────────────────────
# Server-side override: sets the API key for all users.
# Users can also supply their own key in profile settings.
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# ── File upload size limit (bytes) ──────────────────────
# Default: 10 MB. Adjust as needed.
NEXT_PUBLIC_USER_FILE_SIZE_LIMIT=10485760

# ── Other providers (Optional — leave blank to disable) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=

# ── Azure OpenAI (Optional) ──────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_GPT_35_TURBO_NAME=
AZURE_GPT_45_VISION_NAME=
AZURE_GPT_45_TURBO_NAME=
AZURE_EMBEDDINGS_NAME=

# ── Local models via Ollama (Optional) ──────────────────
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# ── Access restriction (Optional) ───────────────────────
# Comma-separated list of allowed email domains or addresses.
# Leave blank to allow all signups.
EMAIL_DOMAIN_WHITELIST=
EMAIL_WHITELIST=
